{
  "name": "agente-logidma",
  "version": "3.1.0",
  "description": "Agente Logidma — WhatsApp Business en Cloudflare Workers",
  "keywords": [
    "whatsapp",
    "webhook",
    "cloudflare-workers"
  ],
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler d1 migrations apply agente-logidma --remote && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json",
    "test": "echo no tests yet!"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.42.0"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
